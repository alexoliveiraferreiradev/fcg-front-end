  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid pink fill, white tracked uppercase label; main action.",
      "html": "<button class=\"ds-btn\">Entrar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 16px;border:1px solid #e01257;border-radius:0;background:#e01257;color:#fff;font:800 11px/1 system-ui,\"Segoe UI\",Roboto,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;transition:background-color .15s,border-color .15s,color .15s;cursor:pointer}.ds-btn:hover{background:#c90e4d;border-color:#c90e4d}.ds-btn:focus-visible{outline:2px solid #ff4d85;outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Default \"+ Carrinho\" on cards; fills pink on hover.",
      "html": "<button class=\"ds-btn-outline\"><svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Carrinho</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;gap:8px;min-height:32px;padding:0 12px;border:1px solid #ed145b;border-radius:0;background:transparent;color:#ff4d85;font:800 11px/1 system-ui,\"Segoe UI\",Roboto,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;transition:background-color .15s,color .15s;cursor:pointer}.ds-btn-outline svg{width:14px;height:14px}.ds-btn-outline:hover{background:#e01257;color:#fff}.ds-btn-outline:focus-visible{outline:2px solid #ff4d85;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Neutral secondary action, e.g. \"Ver todos\", \"Tentar de novo\".",
      "html": "<button class=\"ds-btn-ghost\">Tentar de novo</button>",
      "css": ".ds-btn-ghost{min-height:40px;padding:0 16px;border:1px solid #44474c;border-radius:0;background:transparent;color:#fff;font:800 11px/1 system-ui,\"Segoe UI\",Roboto,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;transition:background-color .15s,border-color .15s;cursor:pointer}.ds-btn-ghost:hover{background:#181818;border-color:#acc1cc}.ds-btn-ghost:focus-visible{outline:2px solid #ff4d85;outline-offset:2px}"
    },
    {
      "name": "Genre Filter",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Square toggle chips; active state fills pink.",
      "html": "<div class=\"ds-genres\"><button class=\"ds-pill\" aria-pressed=\"true\">Todos</button><button class=\"ds-pill\" aria-pressed=\"false\">RPG</button><button class=\"ds-pill\" aria-pressed=\"false\">Racing</button></div>",
      "css": ".ds-genres{display:flex;gap:8px;flex-wrap:wrap}.ds-pill{min-height:32px;padding:0 12px;border:1px solid #2b2d30;border-radius:0;background:transparent;color:#acc1cc;font:600 11px/1 system-ui,\"Segoe UI\",Roboto,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;transition:border-color .15s,color .15s,background-color .15s;cursor:pointer}.ds-pill:hover{border-color:#acc1cc;color:#fff}.ds-pill[aria-pressed=\"true\"]{background:#e01257;border-color:#ed145b;color:#fff}.ds-pill:focus-visible{outline:2px solid #ff4d85;outline-offset:2px}"
    },
    {
      "name": "Game Card",
      "kind": "card",
      "refersTo": "game-card",
      "description": "3:4 cover, discount tag, 2-line name, genre and price; pink border on hover.",
      "html": "<article class=\"ds-card\" tabindex=\"0\"><div class=\"ds-card-cover\"><span class=\"ds-tag\">-25%</span><div class=\"ds-ph\"><span>Neon Rally</span></div></div><div class=\"ds-card-body\"><h3 class=\"ds-card-name\">Neon Rally</h3><span class=\"ds-card-genre\">Racing</span><div class=\"ds-card-row\"><span class=\"ds-price\"><s>R$ 49,90</s><b>R$ 37,42</b></span></div></div></article>",
      "css": ".ds-card{width:200px;display:flex;flex-direction:column;background:#000;border:1px solid #2b2d30;color:#fff;font-family:system-ui,\"Segoe UI\",Roboto,Arial,sans-serif;font-variant-numeric:tabular-nums;transition:border-color .2s}.ds-card:hover{border-color:#ed145b}.ds-card:focus-visible{outline:none;border-color:#ff4d85}.ds-card-cover{position:relative;aspect-ratio:3/4;overflow:hidden;border-bottom:1px solid #2b2d30}.ds-ph{height:100%;display:flex;align-items:flex-end;padding:10%;background:linear-gradient(160deg,#0f4c5c,#041a22)}.ds-ph span{font-weight:900;font-size:22px;line-height:1.02;text-transform:uppercase}.ds-tag{position:absolute;top:8px;left:8px;padding:3px 7px;background:#e01257;color:#fff;font-size:11px;font-weight:800;letter-spacing:.04em;line-height:1.2}.ds-card-body{display:flex;flex-direction:column;gap:2px;padding:12px}.ds-card-name{margin:0;font-size:15px;font-weight:700;line-height:1.25}.ds-card-genre{color:#acc1cc;font-size:11px;letter-spacing:.14em;text-transform:uppercase}.ds-card-row{padding-top:12px}.ds-price{display:inline-flex;gap:8px;align-items:baseline}.ds-price s{color:#7d8f99;font-size:.85em}.ds-price b{font-weight:800}"
    },
    {
      "name": "Section Title",
      "kind": "custom",
      "refersTo": "section-title",
      "description": "Uppercase wide-tracked heading with the 28x3 pink dash.",
      "html": "<h2 class=\"ds-section-title\">Em promoção</h2>",
      "css": ".ds-section-title{display:flex;align-items:center;gap:12px;margin:0;color:#fff;font:800 18px/1.2 system-ui,\"Segoe UI\",Roboto,Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase}.ds-section-title::before{content:\"\";flex:none;width:28px;height:3px;background:#e01257}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Square 44px field on panel; pink-ink focus border and ring.",
      "html": "<label class=\"ds-field\"><span>E-mail</span><input placeholder=\"voce@exemplo.com\"></label>",
      "css": ".ds-field{display:grid;gap:6px;width:280px;font-family:system-ui,\"Segoe UI\",Roboto,Arial,sans-serif}.ds-field span{color:#acc1cc;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.ds-field input{height:44px;padding:0 12px;border:1px solid #44474c;border-radius:0;background:#0e0f10;color:#fff;font:inherit;font-size:15px;transition:border-color .15s}.ds-field input:hover{border-color:#7d8f99}.ds-field input:focus-visible{outline:none;border-color:#ff4d85;box-shadow:0 0 0 1px #ff4d85}.ds-field input::placeholder{color:#7d8f99}"
    },
    {
      "name": "Header Nav",
      "kind": "nav",
      "refersTo": "nav",
      "description": "Text wordmark with pink dot, tracked uppercase links, active pink underline, cart chip with count.",
      "html": "<nav class=\"ds-nav\"><span class=\"ds-logo\"><b>FIAP<i>.</i></b><small>Cloud Games</small></span><a class=\"on\" href=\"#\">Catálogo</a><a href=\"#\">Minha biblioteca</a><span class=\"ds-cart\">Carrinho<em>2</em></span></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:24px;height:64px;padding:0 16px;background:#000;border-bottom:1px solid #2b2d30;font-family:system-ui,\"Segoe UI\",Roboto,Arial,sans-serif}.ds-logo{display:flex;align-items:center;gap:8px;color:#fff}.ds-logo b{font-size:22px;font-weight:900;letter-spacing:.04em}.ds-logo i{font-style:normal;color:#ed145b}.ds-logo small{font-size:11px;letter-spacing:.3em;text-transform:uppercase}.ds-nav a{display:flex;align-items:center;color:#acc1cc;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;text-decoration:none;border-top:2px solid transparent;border-bottom:2px solid transparent;transition:color .15s}.ds-nav a:hover{color:#fff}.ds-nav a.on{color:#ff4d85;border-bottom-color:#ed145b}.ds-nav a:focus-visible{outline:2px solid #ff4d85;outline-offset:2px}.ds-cart{margin-left:auto;align-self:center;display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 12px;border:1px solid #2b2d30;color:#fff;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.ds-cart em{font-style:normal;display:grid;place-items:center;min-width:20px;height:20px;padding:0 5px;background:#181818;font-weight:800;letter-spacing:0}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Notification echo; tone carried by a colored icon square, never a side stripe.",
      "html": "<div class=\"ds-toast\"><span class=\"ds-toast-mark\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"square\" stroke-linejoin=\"miter\" aria-hidden=\"true\"><path d=\"m4 12.5 5 5L20 6.5\"/></svg></span><div class=\"ds-toast-body\"><strong>Pedido aprovado</strong><span>O jogo já está na sua biblioteca.</span></div></div>",
