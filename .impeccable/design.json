  "narrative": {
    "northStar": "The Night Arcade Ledger",
    "overview": "A black storefront with one hot pink, ruled into square cells by 1px hairlines. The covers bring the color. The chrome stays black, white and blue-grey so the game art and the pink actions are what you see first. It reads as a game store, but it is a test client: every price, state and limit on screen comes from the gateway, and the system's job is to show those states clearly, not to dress them up.\n\nThe identity is inspired by FIAP and starts from the approved mockup (`docs/superpowers/specs/2026-10-16-fcg-frontend-mockup.html`). PRODUCT.md calls it a starting point, so future screens follow it, but it can change when something works better. Density is medium: a fluid grid of 3:4 covers, compact uppercase labels, and generous gaps between sections. Ornament is close to zero. The only decorative device in the chrome is the pink dash in front of section titles.",
    "keyCharacteristics": [
      "Pure black ground, near-black panels, 1px grey lines as the main structure.",
      "One accent hue in two jobs: `accent` as a fill under white text, `accent-ink` as pink text on black.",
      "Square corners on every surface, control and tag.",
      "System font stack. Heavy uppercase display, small tracked uppercase labels.",
      "Authored line icons (24px grid, stroke 2, square caps) and authored SVG covers. No emoji, no icon fonts, no third-party art."
    ],
    "rules": [
      {
        "name": "The Three Pinks Rule",
        "body": "`accent` (#ed145b) draws lines: section dashes, underlines, highlight borders, the logo dot. `accent-fill` is the background under white text, because white on #ed145b is only 4.33:1. `accent-ink` is pink text on black. Never set small text in `accent` on black. On black, `accent` measures 4.85:1, which is too thin for 11-13px uppercase labels. `accent-ink` measures 6.65:1.",
        "section": "colors"
      },
      {
        "name": "The Covers Bring the Color Rule",
        "body": "Chrome stays black, white and blue-grey. Saturated color other than pink comes only from game covers, either directly or through the blurred cover backdrop on promo cards.",
        "section": "colors"
      },
      {
        "name": "The Tracked Caps Rule",
        "body": "Every control and metadata label is 11px uppercase with 0.14em tracking. 0.2em is reserved for section titles and the \"Mais promoções\" strip heading, and 0.3em for the \"CLOUD GAMES\" wordmark.",
        "section": "typography"
      },
      {
        "name": "The Pink Dash Rule",
        "body": "Section titles get a 28x3px `accent` dash before them, with a 12px gap. This is the only decorative mark in the chrome.",
        "section": "typography"
      },
      {
        "name": "The Line Before Shadow Rule",
        "body": "Separate surfaces with a 1px `line` border first. Use the lift shadow only when an element floats above other content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** put white text on `accent` fills, and use `accent-ink` for any pink text or pink outline on black.",
      "**Do** keep every corner square and separate surfaces with 1px `line` or `line-strong` borders.",
      "**Do** set controls and metadata in 11px uppercase with 0.14em tracking, and put the 28x3px pink dash before section titles.",
      "**Do** draw icons on the 24px grid with stroke 2, square caps and miter joins, inline as SVG with `currentColor`.",
      "**Do** show status with the status hues (`ok`, `warn`, `danger`) and an icon, and show tone in toasts with the colored icon square.",
      "**Do** keep covers at 3:4 and treat the cart count bump as the only expressive motion. Honor `prefers-reduced-motion`."
    ],
    "donts": [
      "**Don't** round corners or add pill shapes.",
      "**Don't** use colored side stripes (left or right border accents) on cards, notices or toasts.",
      "**Don't** set 11-13px text in `accent` (#ed145b) on black.",
      "**Don't** use emoji, icon fonts or third-party icon packages. Don't use official FIAP logo files. The wordmark is text.",
      "**Don't** introduce a webfont or a second family. The system stack is a brand commitment.",
      "**Don't** add new decorative motion or shadows beyond the lift.",
      "**Don't** ship the amber mock banner outside `dev:mock`."
    ]
  }
